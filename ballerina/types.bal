    string value?;
    # Specifies units of the `anchorXOffset` and `anchorYOffset`. Valid units are:
    # 
    # - `pixels` (default)
    # - `inches`
    # - `mms`
    # - `cms`
    string anchorUnits?;
    # Metadata about a property
    PropertyMetadata yPositionMetadata?;
    # Metadata about a property
    PropertyMetadata recipientIdGuidMetadata?;
