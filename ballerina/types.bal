    # - BrightBlue
    # - BrightRed
    # - DarkGreen
    # - DarkRed
    # - Gold
    # - Green
    # - NavyBlue
    # - Purple
    # - White
    string fontColor?;
    # Metadata about a property
    PropertyMetadata captionMetadata?;
    # The font to be used for the tab value. Supported fonts include:
