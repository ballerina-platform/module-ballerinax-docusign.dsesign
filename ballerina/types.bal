    # - MSMincho
    # - OCR-A
    # - Tahoma
    # - TimesNewRoman
    # - Trebuchet
    # - Verdana
    string font?;
};

# Formatting options for a document generation form field value
public type DocGenFormat record {
    # The expression of the doc gen format.
    string expression?;
    # The user's locale code. Valid values are:
    # - `zh_CN`
    # - `zh_TW`
    # - `nl`
    # - `en`
    # - `fr`
    # - `de`
    # - `it`
    # - `ja`
    # - `ko`
    # - `pt`
    # - `pt_BR`
    # - `ru`
    # - `es`
    string locale?;
};

# This response object contains a list of recipients
public type RecipientNamesResponse record {
    # When **true,** new names cannot be added to the email address
    string reservedRecipientEmail?;
    # When **true,** the email address is used by more than one user
    string multipleUsers?;
    # The names of the recipients associated with the email address
    string[] recipientNames?;
};

# A list of failed envelope IDs to retry
public type ConnectFailureFilter record {
    # Must be **false.** Setting this property to any other value will result in errors
    string synchronous?;
    # An array of envelope GUIDs.
    # 
    # Example: `93be49ab-xxxx-xxxx-xxxx-f752070d71ec`
    string[] envelopeIds?;
};

# Represents the Queries record for the operation: updateEnvelope
public type UpdateEnvelopeQueries record {
    # When **true,**
    # sends the specified envelope again
    @http:Query {name: "resend_envelope"}
    string resendEnvelope?;
    # When **true**, moves the envelope to the recycle bin when it is voided.
    @http:Query {name: "recycle_on_void"}
    string recycleOnVoid?;
    # When **true,** allows the caller to update recipients, tabs, custom fields, notification, email settings and other envelope attributes
    @http:Query {name: "advanced_update"}
    string advancedUpdate?;
};

public type NotaryJournalCredibleWitness record {
    # The address of the witness
    string address?;
    # A base64-encoded image of the signature
    string signatureImage?;
    # The name of the witness
    string name?;
};

public type CommentThread record {
    # The unique identifier for the tab
    string tabId?;
    # When **true,** the sender cannot change any attributes of the recipient. Used only when working with template recipients. 
