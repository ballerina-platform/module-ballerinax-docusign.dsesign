public type ConnectedData record {
    # The supported URI of the connected data.
    string supportedUri?;
    # The property name of the connected data.
    string propertyName?;
    # The type name of the connected data.
    string typeName?;
    # The supported operation of the connected data.
    string supportedOperation?;
    # The type system namespace of the connected data.
    string typeSystemNamespace?;
};

