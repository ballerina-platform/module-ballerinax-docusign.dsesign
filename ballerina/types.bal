    # 
    # Maximum Length: 500 characters
    string tabLabel?;
    # Metadata about a property
    PropertyMetadata anchorHorizontalAlignmentMetadata?;
    # Metadata about a property
    PropertyMetadata anchorTabProcessorVersionMetadata?;
