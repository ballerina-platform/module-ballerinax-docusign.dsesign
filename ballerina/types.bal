    # The sf locked value of the connect salesforce field.
    string sfLockedValue?;
    # The DS node of the connect salesforce field.
    string dsNode?;
};

# Settings that control the behavior of the template edit view
public type TemplateViewSettings record {
    # When **true**, shows header actions.
    string showHeaderActions?;
    # The starting screen of the template view settings.
    string startingScreen?;
    # When **true**, shows back button.
    string showBackButton?;
    # Settings for envelope custom fields in the sender and edit views
    EnvelopeViewEnvelopeCustomFieldSettings envelopeCustomFieldSettings?;
    # When **true**, shows discard action.
    string showDiscardAction?;
    # Settings for recipients in the template edit view
    TemplateViewRecipientSettings recipientSettings?;
    # A unique identifier provided to the owner of the lock. You must use this token with subsequent calls to prove ownership of the lock
    string lockToken?;
    # The back button action of the template view settings.
    string backButtonAction?;
    # Settings for documents in the sender and edit views
    EnvelopeViewDocumentSettings documentSettings?;
    # When **true**, shows advanced options.
    string showAdvancedOptions?;
    # Settings for the tagger (field placement) screen in the sender and edit views
    EnvelopeViewTaggerSettings taggerSettings?;
};

