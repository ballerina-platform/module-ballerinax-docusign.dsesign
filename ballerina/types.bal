    # If blank and the signer `accessCode` property is not set, then the access code is not required
    string accessCode?;
    # The kba of the external primary account recipient auth requirements.
    string kba?;
};

# Represents the Queries record for the operation: createEnvelopeRecipients
public type CreateEnvelopeRecipientsQueries record {
    # When **true,**
    # forces the envelope to be resent
    # if it would not be resent otherwise.
