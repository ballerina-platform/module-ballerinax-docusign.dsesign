    string anchorUnits?;
    # Metadata about a property
    PropertyMetadata yPositionMetadata?;
    # Metadata about a property
    PropertyMetadata fontSizeMetadata?;
    # Metadata about a property
    PropertyMetadata tabOrderMetadata?;
    # Metadata about a property
    PropertyMetadata fontColorMetadata?;
